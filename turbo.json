{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["DATABASE_URL", "NODE_ENV"],
  "tasks": {
    "generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma"],
      "outputs": [
        "../../node_modules/.prisma/client/**",
        "../../node_modules/@prisma/client/**"
      ]
    },
    "migrate:deploy": {
      "cache": false,
      "dependsOn": ["^generate"]
    },
    "migrate:dev": {
      "cache": false,
      "dependsOn": ["^generate"],
      "persistent": true
    },
    "seed": {
      "cache": false,
      "dependsOn": ["^generate"]
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "check-types": {
      "dependsOn": ["^generate"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
